APP_ENV=development
APP_VERSION=3.0.0
API_PREFIX=/api/v1
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000
DATABASE_URL=sqlite:///./dev.db

# Docker Compose database defaults are local-development only.
# For any hosted/private deployment, set a strong random POSTGRES_PASSWORD.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-for-hosted-use
POSTGRES_DB=ecommerce_ops

# AI — keep rules until you intentionally enable paid API usage.
AI_PROVIDER=rules
AI_FALLBACK_TO_RULES=true
OPENAI_API_KEY=
# Set a currently supported Structured Outputs-capable model only when enabling OpenAI.
OPENAI_MODEL=
PROMPT_VERSION=email_understanding_v1
LOW_CONFIDENCE_THRESHOLD=0.75

# Shopify — read only.
SHOPIFY_MODE=mock
SHOPIFY_SHOP=your-development-store
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# Gmail — read support inbox + create drafts. No automatic sending.
GMAIL_MODE=mock
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_QUERY=in:inbox is:unread
GMAIL_SUPPORT_ONLY=true
GMAIL_MAX_BODY_CHARS=5000
# Explicit opt-in for manually sending an already reviewed Gmail Draft.
GMAIL_MANUAL_SEND_ENABLED=false

# External API resilience.
EXTERNAL_API_RETRIES=3
EXTERNAL_API_TIMEOUT_SECONDS=20

# Background jobs.
REDIS_URL=redis://localhost:6379/0
TASKS_MODE=sync
GMAIL_AUTO_POLL=false
GMAIL_POLL_SECONDS=300

# Data / logs.
DATA_RETENTION_DAYS=30
POLICY_VERSION=1.0
LOG_LEVEL=INFO
LOG_JSON=false

# Optional private deployment authentication.
# Keep off for local development and public demo mode.
AUTH_MODE=off
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
SESSION_TTL_MINUTES=480

# Hard safety boundary. Keep false.
ALLOW_LIVE_ACTIONS=false
